# Secretos y configuración local
.env
.claude/settings.local.json

# Entorno y artefactos generados (se reconstruyen con: collector.py --index-only)
.venv/
__pycache__/
*.pyc
*.tmp
index/
logs/
resultados/
ESTADO.md

# Caché HTML del collector (solo para detectar cambios; lo publicado es el markdown)
sources/*/html/

# Snapshots locales de versiones (obsoleto: las versiones anteriores están en el historial de git)
sources/*/versions/

# Estado local del servidor (el historial público es el de git)
changelog/

# Paquete del MCP local generado por .github/scripts/empaquetar.py
dist/
